{
  "name": "copilot-explorer",
  "version": "0.1.107",
  "private": true,
  "type": "module",
  "description": "An exploration map canvas for the GitHub Copilot desktop app.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4 test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "iteration": "node scripts/iteration.mjs",
    "verify:iteration": "node scripts/iteration.mjs verify",
    "validate": "node com.github.copilot/extensions/explorer/validate.mjs",
    "check:ui": "node scripts/check-ui-layout.mjs",
    "e2e": "node scripts/e2e.mjs",
    "smoke:voice": "node scripts/voice-smoke.mjs",
    "preview": "node scripts/preview.mjs",
    "prototype:layouts": "node scripts/prototype-layouts.mjs",
    "benchmark": "node --expose-gc scripts/perf-baseline.mjs",
    "install:copilot": "node scripts/install.mjs",
    "package": "node scripts/package.mjs",
    "e2e:research": "node scripts/e2e-research.mjs",
    "e2e:cleanup": "node scripts/e2e-cleanup.mjs",
    "e2e:question-help": "node scripts/e2e-question-help.mjs",
    "e2e:handoff": "node scripts/e2e-decision-brief.mjs --handoff",
    "e2e:brief": "node scripts/e2e-decision-brief.mjs",
    "e2e:adr": "node scripts/e2e-decision-brief.mjs --adr",
    "e2e:check": "node scripts/e2e-answer-check.mjs",
    "benchmark:impact": "node scripts/perf-impact.mjs"
  },
  "devDependencies": {
    "jsdom": "26.1.0"
  }
}
